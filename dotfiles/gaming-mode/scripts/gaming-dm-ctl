#!/bin/bash
# gaming-dm-ctl — detect display manager and manage autologin
DM_CONF_DIR="/etc/gaming-mode"
DM_CONF="$DM_CONF_DIR/dm.conf"

detect() {
    local dm=""
    for s in sddm gdm lightdm greetd ly; do
        if systemctl is-active --quiet "$s" 2>/dev/null; then
            dm="$s"
            break
        fi
    done
    if [[ -z "$dm" ]]; then
        for s in sddm gdm lightdm greetd ly; do
            if systemctl is-enabled --quiet "$s" 2>/dev/null; then
                dm="$s"
                break
            fi
        done
    fi
    echo "${dm:-none}"
}

get_systemctl_name() {
    case "$(detect)" in
        sddm)    echo "sddm" ;;
        gdm)     echo "gdm" ;;
        lightdm) echo "lightdm" ;;
        greetd)  echo "greetd" ;;
        ly)      echo "ly" ;;
        *)       echo "none" ;;
    esac
}

set_autologin() {
    local session="$1"
    [[ -z "$session" ]] && { echo "Usage: set-autologin <session>"; exit 1; }
    local dm
    dm=$(detect)
    local user="${SUDO_USER:-$USER}"
    [[ -z "$user" ]] && user="$USER"
    mkdir -p "$DM_CONF_DIR"
    echo "$dm" > "$DM_CONF"

    case "$dm" in
        sddm)
            mkdir -p /etc/sddm.conf.d
            cat > /etc/sddm.conf.d/zz-gaming-session.conf <<- EOC
[Autologin]
User=$user
Session=$session
Relogin=true
EOC
            ;;
        gdm)
            if grep -q "^\[daemon\]" /etc/gdm/custom.conf 2>/dev/null; then
                sed -i "/^\[daemon\]/,/^\[/ s/AutomaticLoginEnable=.*/AutomaticLoginEnable=true/" /etc/gdm/custom.conf
                sed -i "/^\[daemon\]/,/^\[/ s/AutomaticLogin=.*/AutomaticLogin=$user/" /etc/gdm/custom.conf
            else
                echo -e "[daemon]\nAutomaticLoginEnable=true\nAutomaticLogin=$user" >> /etc/gdm/custom.conf
            fi
            mkdir -p /var/lib/AccountsService/users
            cat > "/var/lib/AccountsService/users/$user" <<- EOC
[User]
Session=$session
EOC
            ;;
        lightdm)
            if [[ -f /etc/lightdm/lightdm.conf ]]; then
                sed -i "s/^autologin-user=.*/autologin-user=$user/" /etc/lightdm/lightdm.conf
                sed -i "s/^autologin-session=.*/autologin-session=$session/" /etc/lightdm/lightdm.conf
            else
                mkdir -p /etc/lightdm
                cat > /etc/lightdm/lightdm.conf <<- EOC
[Seat:*]
autologin-user=$user
autologin-session=$session
EOC
            fi
            ;;
        greetd)
            cat > /etc/greetd/config.toml <<- EOC
[terminal]
vt = 1

[default_session]
command = "env XDG_SESSION_TYPE=wayland $session"
user = "$user"
EOC
            ;;
        ly)
            mkdir -p /etc/ly
            cat > /etc/ly/save.yml <<- EOC
autologin: true
user: $user
session: $session
EOC
            ;;
        none)
            echo "No display manager detected."
            exit 1
            ;;
    esac
}

disable_autologin() {
    local dm
    dm=$(detect)
    case "$dm" in
        sddm)   > /etc/sddm.conf.d/zz-gaming-session.conf 2>/dev/null || true ;;
        gdm)    sed -i 's/AutomaticLoginEnable=true/AutomaticLoginEnable=false/' /etc/gdm/custom.conf 2>/dev/null || true ;;
        lightdm) sed -i '/^autologin-/d' /etc/lightdm/lightdm.conf 2>/dev/null || true ;;
        greetd) sed -i '/^user = /d' /etc/greetd/config.toml 2>/dev/null || true ;;
        ly)     echo "autologin: false" > /etc/ly/save.yml 2>/dev/null || true ;;
    esac
}

restart() {
    local svc
    svc=$(get_systemctl_name)
    if [[ "$svc" != "none" ]]; then
        systemctl restart "$svc"
    else
        echo "No display manager to restart."
        exit 1
    fi
}

case "${1:-}" in
    detect)          detect ;;
    set-autologin)   set_autologin "${2:-}" ;;
    disable)         disable_autologin ;;
    restart)         restart ;;
    get-service)     get_systemctl_name ;;
    *)
        echo "Usage: $0 {detect|set-autologin <session>|disable|restart|get-service}"
        exit 1
        ;;
esac
