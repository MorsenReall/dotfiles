#!/bin/bash
# gaming-session-switch — set autologin session via gaming-dm-ctl
case "$1" in
  gaming)
    /usr/local/bin/gaming-dm-ctl set-autologin "gamescope-session-steam-nm"
    echo "Session set to: gaming mode"
    ;;
  desktop)
    /usr/local/bin/gaming-dm-ctl set-autologin "hyprland"
    echo "Session set to: desktop mode"
    ;;
  *)
    echo "Usage: $0 {gaming|desktop}" >&2
    exit 1
    ;;
esac
